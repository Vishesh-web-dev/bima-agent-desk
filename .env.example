# Copy to .env.local for `vercel dev`. In production, set these in Vercel > Settings > Environment Variables.
# Added automatically when you connect Neon Postgres from Vercel > Storage:
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# The passcode your brother types to open the client list (use 8+ characters):
APP_PASSCODE=change-me-to-something-long
